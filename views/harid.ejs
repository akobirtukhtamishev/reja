<!DOCTYPE html>
<html lang="uz">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reja va Maqsadlar</title>
  <style>
    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      min-height: 100%;
      font-family: Arial, Helvetica, sans-serif;
      background: #b8b9cc;
      color: #222;
    }

    body {
      border-top: 7px solid #222;
      padding: 8px 18px 40px;
    }

    .page {
      max-width: 1200px;
      margin: 0 auto;
    }

    h1 {
      margin: 0 0 28px;
      text-align: center;
      font-size: clamp(34px, 4.2vw, 54px);
      font-weight: 300;
      letter-spacing: -2px;
      line-height: 1;
    }

    .input-card {
      background: #f5f5f6;
      border-radius: 6px;
      min-height: 68px;
      padding: 12px 18px;
      display: flex;
      gap: 14px;
      align-items: center;
      box-shadow: 0 1px 2px rgba(0,0,0,.08);
    }

    #goalInput {
      flex: 1;
      height: 42px;
      border: 2px solid #a9cdfb;
      border-radius: 5px;
      background: #fff;
      outline: none;
      padding: 0 12px;
      font-size: 18px;
      box-shadow: inset 0 0 0 1px #dceafd;
    }

    #goalInput:focus {
      border-color: #79aef1;
      box-shadow: 0 0 0 2px rgba(66,133,244,.12);
    }

    button {
      border: 0;
      cursor: pointer;
      font: inherit;
      color: white;
      transition: transform .08s ease, filter .15s ease;
    }

    button:active { transform: translateY(1px); }
    button:hover { filter: brightness(.96); }

    .add-btn {
      height: 42px;
      padding: 0 19px;
      border-radius: 22px;
      background: #3f7fe6;
      font-size: 16px;
      white-space: nowrap;
    }

    .goals {
      margin-top: 31px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .goal {
      display: flex;
      align-items: center;
      gap: 12px;
      background: rgba(255,255,255,.72);
      border-radius: 7px;
      padding: 10px 13px;
      min-height: 54px;
    }

    .goal-text {
      flex: 1;
      font-size: 17px;
      color: #333;
      overflow-wrap: anywhere;
    }

    .goal.done .goal-text {
      text-decoration: line-through;
      opacity: .55;
    }

    .check {
      width: 24px;
      height: 24px;
      border-radius: 5px;
      border: 2px solid #3f7fe6;
      background: white;
      flex: 0 0 auto;
      display: grid;
      place-items: center;
      color: white;
      font-size: 15px;
    }

    .goal.done .check {
      background: #3f7fe6;
    }

    .delete {
      background: #d13f55;
      border-radius: 19px;
      padding: 8px 15px;
      font-size: 14px;
      white-space: nowrap;
    }

    .clear-btn {
      margin-top: 32px;
      background: #d13f55;
      border-radius: 20px;
      padding: 9px 15px;
      font-size: 15px;
    }

    .empty {
      display: none;
      text-align: center;
      color: rgba(30,30,40,.55);
      margin-top: 26px;
      font-size: 15px;
    }

    @media (max-width: 650px) {
      body { padding-left: 12px; padding-right: 12px; }
      .input-card { flex-direction: column; align-items: stretch; }
      .add-btn { width: 100%; }
      .goal { align-items: flex-start; }
      .delete { margin-left: auto; }
    }
  </style>
</head>
<body>
  <main class="page">
    <h1>REJA VA MAQSADLAR</h1>

    <section class="input-card">
      <input id="goalInput" type="text" placeholder="Rejalaringizni kiriting" name="goal_write" aria-label="Yangi reja">
      <button class="add-btn" id="addBtn" name="plan_add">Yangi Reja Qo'shish</button>
    </section>

    <section class="goals" id="goals"></section>
    <div class="empty" id="empty">Hozircha reja qo'shilmagan.</div>

    <button class="clear-btn" id="clearBtn">Hamma Rejalarni O'chirish</button>
  </main>

